<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-buildtools</artifactId>
        <version>0.5.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>porelo-release</artifactId>
    <name>Porelo Release</name>
    <description>Porelo - Deciding what an agent package may publish without a person (BUILD)</description>

    <properties>
        <!-- Published: the three agent repositories call this from their own builds and update
             jobs, and three copies of it are what drifted apart. -->
        <maven.deploy.skip>false</maven.deploy.skip>
        <skipPublishing>false</skipPublishing>
    </properties>

    <dependencies>

        <!-- Not porelo-machines: that brings an SSH stack, and these commands run in every
             package build, offline ones included. -->

        <dependency>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-core-java</artifactId>
            <version>${cyclonedx-core-java.version}</version>
        </dependency>

        <!-- Declared, so the flattened pom carries them: CycloneDX alone would bring 2.17 beside the Jackson the rest
             resolves. -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-json</artifactId>
        </dependency>

        <!-- An agent definition is read by Porelo's own reader, never by a pattern over its text. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <!-- The shared .editorconfig check-shared compares a repository's copy with: the root's own, so this
             repository keeps it once, and a release carries the text it was built with. -->
        <resources>
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>.editorconfig</include>
                </includes>
                <targetPath>org/fuin/porelo/release</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.fuin.porelo.release</Automatic-Module-Name>
                            <Main-Class>org.fuin.porelo.release.Main</Main-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <!-- A release builds and packages with no snapshot: on a tag, after 'install' and
                 'help:effective-pom -Doutput=target/effective-pom.xml' for the whole reactor, run as
                 '-pl release exec:java@check-releases' - the check that ships is the one that checks it. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-releases</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.release.Main</mainClass>
                            <arguments>
                                <argument>check-releases</argument>
                                <argument>${maven.multiModuleProjectDirectory}/target/effective-pom.xml</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Every workflow step pinned, for the light check of a pull request that moves only workflows:
                         '-pl release exec:java@check-actions' after the module is built. -->
                    <execution>
                        <id>check-actions</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.release.Main</mainClass>
                            <arguments>
                                <argument>check-actions</argument>
                                <argument>${maven.multiModuleProjectDirectory}/.github</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Every commit of a range held to the shared rule on messages, from the repository's root:
                         '-pl release exec:java@check-commits -Dcommits.range=origin/main..HEAD' before a push or
                         over a pushed range; '@check-commits-outside' for a pull request from outside, which also
                         asks each commit for its author's sign-off. A range left unset ends in exit 2, never a pass. -->
                    <execution>
                        <id>check-commits</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.release.Main</mainClass>
                            <arguments>
                                <argument>check-commits</argument>
                                <argument>${commits.range}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-commits-outside</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.release.Main</mainClass>
                            <arguments>
                                <argument>check-commits</argument>
                                <argument>${commits.range}</argument>
                                <argument>--outside</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- The deploy dry run of every push, read: '-pl release exec:java@check-deploy' after the dry run
                         wrote target/deploy-dry-run.log. -->
                    <execution>
                        <id>check-deploy</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.release.Main</mainClass>
                            <arguments>
                                <argument>check-deploy</argument>
                                <argument>${maven.multiModuleProjectDirectory}/target/deploy-dry-run.log</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
